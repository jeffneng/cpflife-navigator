# Copy this file to .streamlit/secrets.toml (NOT committed to git) and fill
# in your own key for local development. On Streamlit Community Cloud,
# instead paste this into your app's Settings -> Secrets box.

OPENAI_API_KEY = "sk-..."

# Shared passphrase gate for the whole app (cpf_life/auth.py) — not real user
# accounts, just a deterrent against random public access. Pick any
# passphrase. If this key is omitted entirely, the app runs unprotected.
APP_PASSWORD = "choose-a-passphrase"
